{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "images": "node scripts/optimize-images.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "build": "node scripts/generate-sitemap.mjs && vite-react-ssg build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "check:lock-sync": "node scripts/check-lock-sync.mjs",
    "monitor:synthetic": "node scripts/synthetic-monitor.mjs",
    "monitor:slo": "node scripts/check-slo-thresholds.mjs synthetic-results.json",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:smoke": "playwright test",
    "test:form": "playwright test contact-form",
    "test:smoke:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "@types/qrcode": "^1.5.6",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "openscad-wasm": "^0.0.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.6.1",
    "beasties": "^0.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.9.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-react-ssg": "^0.9.2"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "rollup": "^4.52.0"
  }
}
