{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "images": "node scripts/optimize-images.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "build": "node scripts/generate-sitemap.mjs && vite-react-ssg build && node scripts/apply-csp.mjs",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "check:lock-sync": "node scripts/check-lock-sync.mjs",
    "monitor:synthetic": "node scripts/synthetic-monitor.mjs",
    "monitor:slo": "node scripts/check-slo-thresholds.mjs synthetic-results.json",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:smoke": "playwright test",
    "test:form": "playwright test contact-form",
    "test:smoke:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/qrcode": "^1.5.6",
    "d3-geo": "^3.1.1",
    "fflate": "^0.8.3",
    "heic-to": "^1.6.6",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.58.0",
    "openscad-wasm": "^0.0.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.64.0",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "beasties": "^0.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-react-ssg": "^0.9.2"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "rollup": "^4.52.0"
  }
}
