# Cloudflare Pages headers. This is the only headers file: Vite copies it to
# dist/_headers and scripts/apply-csp.mjs fills in the CSP hashes there.
#
# Cloudflare joins a header set by more than one matching rule with a comma,
# so set each header in one place only. Limits (checked at the end of every
# build by scripts/check-cloudflare-output.mjs): 100 rules, 2,000 characters
# per line.

/*
 # script-src has no 'unsafe-inline'. scripts/apply-csp.mjs runs after the build, moves each page's
 # hydration script to /assets and fills in the hashes of the remaining inline
 # scripts and the font preload's onload (hence 'unsafe-hashes'). 'unsafe-eval' stays for libheif's
 # embind (HEIC uploads in /admin); drop it once /admin carries its own policy.
 Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-eval' 'unsafe-hashes' {{CSP_SCRIPT_HASHES}} https://www.googletagmanager.com https://www.google-analytics.com https://googletagmanager.com https://analytics.google.com https://ssl.google-analytics.com https://stats.g.doubleclick.net https://gc.zgo.at https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com data:; img-src 'self' https: data: blob: https://images.pexels.com https://www.google-analytics.com https://ssl.google-analytics.com https://www.googletagmanager.com https://googletagmanager.com https://analytics.google.com https://stats.g.doubleclick.net https://*.supabase.co; media-src 'self' https:; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://googletagmanager.com https://analytics.google.com https://ssl.google-analytics.com https://region1.google-analytics.com https://stats.g.doubleclick.net https://gc.zgo.at https://ipapi.co https://*.supabase.co wss://*.supabase.co https://*.supabase.in https://cloudflareinsights.com; frame-src https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://www.google.com https://google.com; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:; manifest-src 'self';

 # Clickjacking legacy fallback
 X-Frame-Options: DENY

 # HTTP Strict Transport Security - Force HTTPS
 Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

 # Cross-Origin Opener Policy
 Cross-Origin-Opener-Policy: same-origin

 # Additional security headers
 X-Content-Type-Options: nosniff
 Referrer-Policy: strict-origin-when-cross-origin
 Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/fonts/*
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

/assets/*
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

/*.png
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

/*.jpg
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

/*.jpeg
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

/*.webp
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

/*.svg
 Cache-Control: public, max-age=31536000, immutable
 Cross-Origin-Resource-Policy: cross-origin

# Private areas and one-off pages stay out of the index.
#
# Not set anywhere, on purpose:
#   - "X-Robots-Tag: index, follow" on public pages: that is the default
#     when the header is absent, and adding it to /* would merge with the
#     noindex rules below into a contradictory value.
#   - "Cache-Control: public, max-age=0, must-revalidate" on public pages:
#     Cloudflare already sends exactly that for HTML pages.

/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/portal
  X-Robots-Tag: noindex, nofollow

/portal/*
  X-Robots-Tag: noindex, nofollow

/store/success
  X-Robots-Tag: noindex, follow
  Cache-Control: no-store

# Apple Pay domain verification. Stripe checks this file over HTTPS before it
# will show an Apple Pay button. It has no extension, so pin the type. See
# docs/apple-pay.md.
/.well-known/apple-developer-merchantid-domain-association
  ! Content-Type
  Content-Type: text/plain
  X-Robots-Tag: noindex, nofollow

# Markdown twins of the public pages (scripts/generate-markdown.mjs). AI agents
# get them at the page's own URL by sending "Accept: text/markdown"
# (functions/_middleware.ts). The .md addresses themselves stay out of search
# so they never compete with the HTML page.
/*.md
  X-Robots-Tag: noindex
